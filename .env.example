# -----------------------------------------------------------------------------
# Sourcebook local-first configuration (macOS host process)
# Copy to .env and fill in required credentials before running.
# -----------------------------------------------------------------------------

# Object storage: MinIO is the default. The bucket stays private.
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9000
# Public/browser-facing address used to sign browser-upload/download URLs.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=sourcebook
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Pinned local-development image tags used by this Compose setup.
MINIO_SERVER_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z-cpuv1
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z

# AWS S3 mode (used only when STORAGE_PROVIDER=s3).
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_SERVER_SIDE_ENCRYPTION=AES256
MINIO_SERVER_SIDE_ENCRYPTION=

# PostgreSQL installed natively on the Mac. DATABASE_URL takes precedence when set.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sourcebook
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Authentication and browser configuration. Replace JWT_SECRET with a strong unique value.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PRESIGNED_UPLOAD_EXPIRE_SECONDS=900

# Local Ollama. For the containerized API, Compose overrides the base URL to host.docker.internal.
EMBEDDING_PROVIDER=ollama
GENERATION_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONTAINER_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=4
OLLAMA_NUM_CTX=4096
OLLAMA_SAFE_CHUNK_CHARS=1200
OLLAMA_MAX_RETRIES=4
OLLAMA_REQUEST_TIMEOUT_SECONDS=90
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_RERANK_MODEL=bge-m3
OLLAMA_CHAT_TEMPERATURE=0.1
RAG_CANDIDATE_POOL_SIZE=20
RAG_RERANK_TOP_K=3
AUTO_EMBED_ON_INGESTION=true

# Optional Stage 2 extractor tuning.
SPACY_MODEL_NAME=en_core_web_sm
PDF_PARSER=docling
LOG_LEVEL=INFO
